# Copy to .env if you need overrides. Defaults work without this file.
BRIDGE_PORT=31337
# Leave model IDs unset to use the Codex default. No model ID is impersonated.
# BRIDGE_MODEL=your-codex-model-id
# BRIDGE_HELPER_MODEL=your-codex-model-id
BRIDGE_REASONING_EFFORT=low
BRIDGE_TIMEOUT_MS=120000
BRIDGE_MAX_CONCURRENT=2
# Optional existing dedicated Codex home. Its config and MCP servers are trusted.
# BRIDGE_CODEX_HOME=/absolute/path/to/dedicated/codex-home
# Optional native executable (not a shell wrapper that changes CODEX_HOME).
# BRIDGE_CODEX_PATH=/absolute/path/to/codex
# Otherwise the bridge generates a private local provider token.
# BRIDGE_TOKEN=at-least-24-characters-without-whitespace
