{
  "name": "codex-jetbrains-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "JetBrains AI Assistant custom provider backed by the official Codex SDK",
  "type": "module",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "test": "node --test",
    "check": "node --check src/main.js && node --test",
    "login": "node --env-file-if-exists=.env src/main.js login",
    "doctor": "node --env-file-if-exists=.env src/main.js doctor",
    "token": "node --env-file-if-exists=.env src/main.js token",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.js"
  },
  "dependencies": { "@openai/codex-sdk": "0.154.0" }
}
