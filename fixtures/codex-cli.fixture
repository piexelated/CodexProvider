#!/usr/bin/env node
// Offline transport fixture: the real official SDK launches this instead of Codex.
const assert = require('node:assert/strict');
const fs = require('node:fs');
const args = process.argv.slice(2);
if (args.includes('login')) {
  console.error('Logged in using ChatGPT');
  process.exit(0);
}
assert.equal(args[0], 'exec');
assert.ok(args.includes('--experimental-json'));
assert.equal(args[args.indexOf('--sandbox') + 1], 'read-only');
assert.ok(args.includes('forced_login_method="chatgpt"'));
assert.ok(args.includes('model_provider="openai"'));
assert.ok(args.includes('features.shell_tool=false'));
assert.equal(process.env.OPENAI_API_KEY, undefined);
assert.equal(process.env.CODEX_API_KEY, undefined);
let prompt = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (data) => { prompt += data; });
process.stdin.on('end', () => {
  assert.match(prompt, /JSON conversation transcript/);
  const emit = (event) => console.log(JSON.stringify(event));
  emit({ type: 'thread.started', thread_id: 'offline-thread' });
  emit({ type: 'turn.started' });
  if (prompt.includes('WAIT_FOR_CANCELLATION')) {
    setInterval(() => {}, 1000);
    return;
  }
  let text = 'regionCount';
  if (args.includes('--output-schema')) {
    const schema = JSON.parse(fs.readFileSync(args[args.indexOf('--output-schema') + 1], 'utf8'));
    assert.equal(schema.type, 'object');
    text = '{"names":["regionCount"]}';
  }
  emit({ type: 'item.completed', item: { id: 'progress', type: 'agent_message', text: 'Do not return this progress message.' } });
  emit({ type: 'item.completed', item: { id: 'final', type: 'agent_message', text } });
  emit({ type: 'turn.completed', usage: { input_tokens: 12, cached_input_tokens: 0, output_tokens: 3 } });
});
